# From LINE Developers Console → your "LINE Login" channel → Basic settings.
AUTH_LINE_ID=2011331358
AUTH_LINE_SECRET=30280a391a2348247be7fabd28f59768

AUTH_SECRET=nwa16GvXZ/fJAXjGPFe4ParguniHFey5TsCijhjC+zA=

# Must match the ngrok URL you set as the LINE Login Callback URL — update
# this line whenever ngrok gives you a new address.
AUTH_URL=https://grimy-scabby-fiction.ngrok-free.dev/api/auth

# From Supabase → Project Settings → API. SUPABASE_SERVICE_ROLE_KEY is a
# secret with full DB access — server-only, never expose it to the browser.
SUPABASE_URL=https://ixcqghcvefoklpyjyoqr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_314C1YtKfoS-X7CTi86EmA_IBWTXMCz

# Direct Postgres connection (Project Settings → Database → Connection string).
# Only for one-off admin scripts/migrations — the app itself never uses this,
# it only ever talks to Supabase through the service-role client above.
SUPABASE_DB_URL=postgresql://postgres:B_n/2^wp?gfCnAZ@db.ixcqghcvefoklpyjyoqr.supabase.co:5432/postgres

# Thunder / EasySlip — verifies a customer's uploaded bank-transfer slip
# (real name/amount/account, not a fake image) via https://api.thunder.in.th/v1/verify.
# Server-only: called from a Server Action, never from the browser.
EASYSLIP_API=5ff20fd1-12a7-4b07-bf8c-8ce841f26800
TW_ACCESS_TOKEN=5ff20fd1-12a7-4b07-bf8c-8ce841f26800

# Who can see /admin — comma-separated LINE user ids. Log in once and visit
# /admin — if you're not on this list yet, it'll show your id so you can
# paste it in here (e.g. ADMIN_LINE_USER_IDS=Uabc123,Udef456).
ADMIN_LINE_USER_IDS=Uf9b767d38aba52c9c61c3e4249b88ba9

# Set this once the site has a real production domain, e.g.
# https://jklottery.co.th (no trailing slash) — needed for sitemap.xml,
# robots.txt, and metadata to use correct absolute URLs. Falls back to
# http://localhost:3000 while this is blank.
NEXT_PUBLIC_SITE_URL=

# Protects the scheduled auto-fetch endpoint (src/app/api/cron/fetch-draw)
# from being called by anyone else. If deployed on Vercel, set this exact
# same value as an env var in the Vercel project settings too — Vercel then
# sends it automatically as the Authorization header when it invokes the
# cron job (https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs).
CRON_SECRET=38ccb0fd7023ee328ffc80e3b1ed836ed16cfa34124e58b7
