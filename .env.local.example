# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# From LINE Developers Console (https://developers.line.biz/console/)
# → create a Provider → create a "LINE Login" channel → Basic settings tab.
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# Random secret Auth.js uses to sign session cookies/JWTs. Generate one with:
#   npx auth secret
# (writes it straight into .env.local for you)
AUTH_SECRET=

# From your Supabase project → Project Settings → API.
# SUPABASE_SERVICE_ROLE_KEY has full DB access — server-only, never expose
# it to the browser or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — direct Postgres connection string (Project Settings → Database
# → Connection string), only needed for one-off admin scripts/migrations.
# The app itself never reads this.
SUPABASE_DB_URL=

# From https://thunder.in.th/ dashboard — verifies a customer's uploaded
# bank-transfer slip against api.thunder.in.th/v1/verify. Server-only.
EASYSLIP_API=
TW_ACCESS_TOKEN=

# Who can see /admin — comma-separated LINE user ids (the ones stored in the
# `users` table / session.user.id, not LINE display names). Log in once and
# visit /admin — if you're not on this list yet, it shows your id so you can
# add it here. e.g. ADMIN_LINE_USER_IDS=Uabc123...,Udef456...
ADMIN_LINE_USER_IDS=

# The site's real production domain, e.g. https://jklottery.co.th (no
# trailing slash). Used for metadataBase, sitemap.xml, robots.txt, and
# structured-data URLs. Falls back to http://localhost:3000 if unset, so
# it's safe to leave blank in local dev.
NEXT_PUBLIC_SITE_URL=

# Random secret protecting src/app/api/cron/fetch-draw (the scheduled
# auto-fetch of each new draw) from being called by anyone else. Generate
# one with e.g. `openssl rand -hex 24`, and set the SAME value as an env
# var on whatever host runs the cron (on Vercel, it's sent automatically as
# the Authorization header — see vercel.json).
CRON_SECRET=
